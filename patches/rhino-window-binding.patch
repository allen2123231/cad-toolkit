--- /dev/null
+++ b/plugin/ToolkitIdentity.cs
@@ -0,0 +1,63 @@
+using System;
+using System.IO;
+using Newtonsoft.Json.Linq;
+using Rhino;
+
+namespace RhinoMCPPlugin;
+
+// Lifetime is the loaded Rhino process, independent of documents or TCP ports.
+static class ToolkitIdentity
+{
+    internal static readonly string InstanceId = Guid.NewGuid().ToString("N");
+    static long epoch;
+    static uint serial;
+    static bool initialized;
+
+    internal static void Initialize()
+    {
+        if (initialized) return;
+        initialized = true;
+        serial = RhinoDoc.ActiveDoc?.RuntimeSerialNumber ?? 0;
+        RhinoDoc.ActiveDocumentChanged += (_, _) => {
+            serial = RhinoDoc.ActiveDoc?.RuntimeSerialNumber ?? 0;
+            epoch++;
+        };
+    }
+
+    internal static JObject Context()
+    {
+        Initialize();
+        var doc = RhinoDoc.ActiveDoc;
+        uint current = doc?.RuntimeSerialNumber ?? 0;
+        if (current != serial) { serial = current; epoch++; }
+        return new JObject {
+            ["toolkit_managed"] = ToolkitIntegration.IsManaged,
+            ["guard_protocol"] = 1, ["instance_id"] = InstanceId,
+            ["hwnd"] = RhinoApp.MainWindowHandle().ToInt64(),
+            ["document_serial"] = serial, ["document_epoch"] = epoch,
+            ["document"] = doc?.Name, ["documentPath"] = doc?.Path
+        };
+    }
+
+    internal static JObject Validate(JObject guard, bool readOnly)
+    {
+        if (guard == null) return null; // Existing standalone clients remain compatible.
+        var current = Context();
+        string code = null, message = null;
+        if ((int?)guard["protocol"] != 1 || (string)guard["instance_id"] != InstanceId || (long?)guard["hwnd"] != (long)current["hwnd"])
+        { code = "window_mismatch"; message = "Rhino 視窗身分已改變。請回 MCP Toolkit 重新選窗；此次工具未執行。"; }
+        else if (!readOnly && ((long?)guard["document_serial"] != (long)current["document_serial"] || (long?)guard["document_epoch"] != (long)current["document_epoch"]))
+        { code = "document_changed"; message = "Rhino 已切換文件。請在 MCP Toolkit 確認文件，再重新送出指令；此次工具未執行。"; }
+        return code == null ? null : new JObject { ["status"] = "error", ["code"] = code, ["message"] = message };
+    }
+
+    internal static string TitleName()
+    {
+        try {
+            string file = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "RhinoMCP", "names", InstanceId + ".json");
+            var data = JObject.Parse(File.ReadAllText(file));
+            string name = (string)data["name"];
+            return (bool?)data["enabled"] == true && !string.IsNullOrWhiteSpace(name) && name.Length <= 48 && name.IndexOfAny(new[]{'[',']','\r','\n'}) < 0 ? name : null;
+        } catch (Exception) { return null; }
+    }
+}
