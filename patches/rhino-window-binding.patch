diff --git a/plugin/ToolkitIntegration.cs b/plugin/ToolkitIntegration.cs
new file mode 100644
--- /dev/null
+++ b/plugin/ToolkitIntegration.cs
@@ -0,0 +1,43 @@
+using System;
+using System.Diagnostics;
+using System.IO;
+using System.Text.Json;
+
+namespace RhinoMCPPlugin;
+
+// This immutable marker ships only in Toolkit-managed packages, independently
+// of how Rhino starts or whether the manager is currently running.
+static class ToolkitIntegration
+{
+    internal static bool IsManaged => IsManagedAt(Path.GetDirectoryName(typeof(ToolkitIntegration).Assembly.Location));
+    internal static bool IsManagedAt(string directory)
+    {
+        try {
+            using var data = JsonDocument.Parse(File.ReadAllText(Path.Combine(directory, "toolkit-integration.json")));
+            return data.RootElement.GetProperty("schema").GetInt32() == 1 && data.RootElement.GetProperty("mode").GetString() == "mcp-toolkit";
+        } catch (Exception) { return false; }
+    }
+    internal static ProcessStartInfo ManagerStartInfo(string locator)
+    {
+        try {
+            using var data = JsonDocument.Parse(File.ReadAllText(locator));
+            if (data.RootElement.GetProperty("schema").GetInt32() != 1) return null;
+            string root = data.RootElement.GetProperty("root").GetString();
+            if (string.IsNullOrWhiteSpace(root) || !Path.IsPathFullyQualified(root)) return null;
+            root = Path.GetFullPath(root);
+            string exe = Path.Combine(root, "McpToolkit.exe");
+            if (!File.Exists(exe) || !File.Exists(Path.Combine(root, "state.json"))) return null;
+            var start = new ProcessStartInfo(exe) { UseShellExecute = false, WorkingDirectory = root };
+            start.ArgumentList.Add("--root=" + root);start.ArgumentList.Add("--page=mcps");
+            return start;
+        } catch (Exception) { return null; }
+    }
+    internal static bool OpenManager()
+    {
+        try {
+            var start = ManagerStartInfo(Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "RhinoMCP", "toolkit-manager.json"));
+            if (start == null) return false;
+            Process.Start(start)?.Dispose();return true;
+        } catch (Exception) { return false; }
+    }
+}
