<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>McpToolkit</AssemblyName>
    <RootNamespace>CadToolkitSetup</RootNamespace>
    <ApplicationIcon>assets/mcp-toolkit.ico</ApplicationIcon>
    <Product>MCP Toolkit</Product>
    <Company>allen2123231</Company>
    <Description>MCP Toolkit for Rhino, AutoCAD and Inventor</Description>
    <Version>0.5.0-beta.4</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="release.json" /><EmbeddedResource Include="assets/mcp-toolkit.ico" LogicalName="CadToolkitSetup.brand.ico" /><EmbeddedResource Include="assets/lucide-LICENSE.txt" /><EmbeddedResource Include="assets/icons/*.png" LogicalName="CadToolkitSetup.icons.%(Filename)%(Extension)" /><EmbeddedResource Include="../engine/*.py" LogicalName="CadToolkitSetup.engine.%(Filename)%(Extension)" /><EmbeddedResource Include="../sources.json" LogicalName="CadToolkitSetup.sources.json" /></ItemGroup>
</Project>
